[Unit]
Description=Back up the GDSA practice SQLite database
RequiresMountsFor=/opt/security-study/data /var/backups/gdsa-practice

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/security-study/current/backend
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/security-study/venv/bin/python /opt/security-study/current/backend/database_admin.py backup --database /opt/security-study/data/gdsa-practice.sqlite3 --backup-dir /var/backups/gdsa-practice --project "SEC530 - GDSA"
UMask=0027

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/opt/security-study
ReadWritePaths=/var/backups/gdsa-practice
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
