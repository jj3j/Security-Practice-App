# Copy this file to /etc/gdsa-practice/gdsa-practice.env on the EC2 instance.
# Set ownership to root:gdsa-practice and permissions to 0640.
# Never commit the populated production file.

GDSA_DATABASE_PATH=/opt/gdsa-practice/data/gdsa-practice.sqlite3
GDSA_LEARNER_DATABASE_PATH=/var/lib/gdsa-practice/learner.sqlite3
GDSA_STUDY_CONTENT_PATH=/opt/gdsa-practice/current/content/sec530-study.json
GDSA_RAG_INDEX_PATH=/opt/gdsa-practice/data/projects_index.jsonl
GDSA_PROJECT_ID="SEC530 - GDSA"
GDSA_PORT=8765
GDSA_WORKERS=2
GDSA_LOG_LEVEL=info

# Must be the HTTPS origin used by the browser and Google OAuth redirect URI.
GDSA_PUBLIC_BASE_URL=https://practice.example.com
GDSA_GOOGLE_CLIENT_ID=
GDSA_GOOGLE_CLIENT_SECRET=
GDSA_SESSION_IDLE_SECONDS=3600
GDSA_SESSION_LIFETIME_SECONDS=43200
GDSA_OIDC_HTTP_TIMEOUT_SECONDS=10
