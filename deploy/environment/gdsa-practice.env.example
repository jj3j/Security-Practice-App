# Copy this file to /etc/security-study/gdsa-practice.env on the EC2 instance.
# Set ownership to root:gdsa-practice and permissions to 0640.
# Never commit the populated production file.

GDSA_DATABASE_PATH=/opt/security-study/data/gdsa-practice.sqlite3
GDSA_LEARNER_DATABASE_PATH=/var/lib/gdsa-practice/learner.sqlite3
# Each release links current/content to /opt/security-study/data/content.
GDSA_STUDY_CONTENT_PATH=/opt/security-study/current/content/sec530-study.json
# CISSP_STUDY_CONTENT_PATH=/opt/security-study/current/content/cissp-study.json
# CISSP_RAG_INDEX_PATH=/opt/security-study/current/content/cissp-study-sources.jsonl
# GMON_STUDY_CONTENT_PATH=/opt/security-study/current/content/gmon-study.json
# GMON_RAG_INDEX_PATH=/opt/security-study/current/content/gmon-study-sources.jsonl
GDSA_RAG_INDEX_PATH=/opt/security-study/data/projects_index.jsonl
GDSA_PROJECT_ID="SEC530 - GDSA"
GDSA_PORT=8765
GDSA_WORKERS=2
GDSA_LOG_LEVEL=info

# Must be the HTTPS origin used by the browser and Google OAuth redirect URI.
GDSA_PUBLIC_BASE_URL=https://practice.example.com
GDSA_GOOGLE_CLIENT_ID=
GDSA_GOOGLE_CLIENT_SECRET=
GDSA_SESSION_IDLE_SECONDS=3600
GDSA_SESSION_LIFETIME_SECONDS=43200
GDSA_OIDC_HTTP_TIMEOUT_SECONDS=10
